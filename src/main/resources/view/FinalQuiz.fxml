<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.FinalQuizController" styleClass="app-root" prefWidth="1200" prefHeight="760">
 <top><HBox spacing="18" alignment="CENTER_LEFT" styleClass="top-bar"><Label text="FINAL ESCAPE PROTOCOL" styleClass="eyebrow"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="scoreLabel" text="XP  0"/><Label fx:id="timerLabel" text="20 s"/><ProgressBar fx:id="timer" prefWidth="140" progress="1"/></HBox></top>
 <center><VBox maxWidth="Infinity" maxHeight="Infinity" alignment="CENTER" spacing="18" styleClass="glass-card,question-screen-overlay"><Label fx:id="questionNumber" styleClass="eyebrow"/><ProgressBar fx:id="progress" prefWidth="760" maxWidth="760"/><Label fx:id="question" wrapText="true" textAlignment="CENTER" maxWidth="820" styleClass="question-title"/><VBox fx:id="choices" spacing="12" maxWidth="800"/><Label fx:id="feedback" wrapText="true" textAlignment="CENTER" maxWidth="820" styleClass="feedback"/></VBox></center>
</BorderPane>
