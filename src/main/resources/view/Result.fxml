<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ResultController" styleClass="app-root"><VBox alignment="CENTER" spacing="20" maxWidth="820" styleClass="glass-card"><Label fx:id="headline" wrapText="true" textAlignment="CENTER" styleClass="hero-subtitle"/><Label fx:id="stars" text="★★★★★" styleClass="stars"/><HBox alignment="CENTER" spacing="18"><VBox alignment="CENTER" styleClass="stat-card"><Label text="TOTAL XP" styleClass="eyebrow"/><Label fx:id="score" styleClass="stat-value"/></VBox><VBox alignment="CENTER" styleClass="stat-card"><Label text="ACCURACY" styleClass="eyebrow"/><Label fx:id="accuracy" styleClass="stat-value"/></VBox><VBox alignment="CENTER" styleClass="stat-card"><Label text="TIME" styleClass="eyebrow"/><Label fx:id="time" styleClass="stat-value"/></VBox></HBox><Label text="ACHIEVEMENTS" styleClass="eyebrow"/><FlowPane fx:id="achievements" alignment="CENTER" hgap="10" vgap="10"/><HBox alignment="CENTER" spacing="10"><Button text="PLAY AGAIN" onAction="#replay" styleClass="primary-button"/><Button text="MAIN MENU" onAction="#menu"/><Button text="EXIT" onAction="#exit" styleClass="ghost-button"/></HBox></VBox></StackPane>
